{
  "name": "@themis/github-app",
  "version": "0.1.0",
  "private": true,
  "description": "Themis GitHub App: webhook server, dashboard and publish step",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@themis/core": "workspace:*",
    "probot": "14.3.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  }
}
