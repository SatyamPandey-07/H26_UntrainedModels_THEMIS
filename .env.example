# LLM (Groq) — required
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Engine limits
THEMIS_RETRY_CAP=2
THEMIS_MAX_OPEN_PRS=3

# GitHub App (Probot) — written by the Probot manifest flow on first start
APP_ID=
PRIVATE_KEY_PATH=
WEBHOOK_SECRET=
WEBHOOK_PROXY_URL=

# Alert webhook (optional)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
