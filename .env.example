# LLM (Groq) — at least one key is required. Add more keys from other Groq organizations to spread the
# per-minute and per-day token limits (limits are per organization). Keys are tried in numeric order.
GROQ_API_KEY_1=your-groq-api-key
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# GROQ_API_KEY=            # single-key form, still supported
# GROQ_API_KEYS=k1,k2,k3   # comma separated alternative
GROQ_MODEL=openai/gpt-oss-120b
# Tried after GROQ_MODEL on every key when it is rate limited. Comma separated; "none" disables.
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Engine limits
THEMIS_RETRY_CAP=2
THEMIS_MAX_OPEN_PRS=3

# GitHub App (Probot) — written by the Probot manifest flow on first start
APP_ID=
PRIVATE_KEY_PATH=
WEBHOOK_SECRET=
WEBHOOK_PROXY_URL=

# Alert webhook (optional)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
